# Copy to .env and fill in. Generate secrets with: openssl rand -base64 48
APP_ENV=production
PUBLIC_URL=https://refres.co
POSTGRES_PASSWORD=
JWT_SECRET=
APP_SECRET=
MOCK_WEBHOOK_SECRET=
COOKIE_SECURE=true
SESSION_TTL=12h
TIME_ZONE=Africa/Maputo
# mock, or mpesa for real payments. With mpesa, e-Mola, cards and bank payouts show as coming soon.
PAYMENTS_PROVIDER=mock
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_SERVICE_PROVIDER_CODE=
# Defaults: https://api.vm.co.mz, 18352 and 18353
# MPESA_BASE_URL=
# MPESA_C2B_PORT=
# MPESA_QUERY_PORT=
# The mock gateway credits balances without real payments, so production refuses it.
# Set to true only on a staging stack; every page then shows a test-mode banner.
PAYMENTS_ALLOW_MOCK_IN_PRODUCTION=false
MOCK_AUTO_CONFIRM=8s
PAYMENTS_ALLOW_SIMULATE=false
# Email through SMTP; without it notifications only go to the log. A server that
# offers STARTTLS must present a certificate for this host name.
SMTP_ADDR=
MAIL_FROM=refres.co <no-reply@rihagateway.com>
# Bootstrap super admin (created on first start if missing)
ADMIN_EMAIL=admin@refres.co
ADMIN_PASSWORD=
# Only needed when the SPA is served from another origin
ALLOWED_ORIGINS=
