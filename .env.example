# Copy to .env and fill in. Generate secrets with: openssl rand -base64 48
APP_ENV=production
PUBLIC_URL=https://refres.co
POSTGRES_PASSWORD=
JWT_SECRET=
APP_SECRET=
MOCK_WEBHOOK_SECRET=
COOKIE_SECURE=true
SESSION_TTL=12h
TIME_ZONE=Africa/Maputo
PAYMENTS_PROVIDER=mock
# The mock gateway credits balances without real payments, so production refuses it.
# Set to true only on a staging stack; every page then shows a test-mode banner.
PAYMENTS_ALLOW_MOCK_IN_PRODUCTION=false
MOCK_AUTO_CONFIRM=8s
PAYMENTS_ALLOW_SIMULATE=false
# Bootstrap super admin (created on first start if missing)
ADMIN_EMAIL=admin@refres.co
ADMIN_PASSWORD=
# Only needed when the SPA is served from another origin
ALLOWED_ORIGINS=
